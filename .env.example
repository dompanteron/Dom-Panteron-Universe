# =========================
# Dom Panteron Universe
# Example environment file
# =========================

# --- Core app URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Email / notifications (recommended) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Dom Panteron <onboarding@resend.dev>
# Inbox for new order / raffle alerts (same Resend account)
ADMIN_EMAIL=your-admin-email@example.com

# --- Payments (optional for now; required when enabling checkout flows) ---
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox | live (auto-detected from client id if omitted)
PAYPAL_ENV=
# PayPal Developer → Webhooks (production); enables signature verification
PAYPAL_WEBHOOK_ID=

# --- Admin / migration helpers (optional) ---
ADMIN_ONBOARDING_CODE=
MIGRATE_HATS_SECRET=

# --- Legacy Wix integration (optional; keep empty unless intentionally used) ---
NEXT_PUBLIC_WIX_CLIENT_ID=
NEXT_PUBLIC_WIX_SITE_ID=
NEXT_PUBLIC_WIX_METASITE_ID=
NEXT_PUBLIC_WIX_ACCOUNT_ID=
NEXT_PUBLIC_WIX_API_KEY=
WIX_CLIENT_SECRET=
WIX_REDIRECT_URI=
WIX_REFERER_URL=https://www.wix.com/
